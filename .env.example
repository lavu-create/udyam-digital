# Project Udyam Digital - Environment Configuration Example
# Copy to .env for custom configuration (DO NOT commit .env with secrets)

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///./udyam_digital.db

# Optional AI LLM Provider Keys (System defaults to 100% deterministic rule fallback when keys are absent)
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Local Verification Anchors
ANCHOR_DATE=2026-07-15
MAX_BILL_AGE_DAYS=90
BLUR_LAPLACIAN_THRESHOLD=250.0

# DPDP 2023 Consent Version
DPDP_TERMS_VERSION=1.0-DPDP2023

